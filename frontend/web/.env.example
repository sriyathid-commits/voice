# API Configuration
NEXT_PUBLIC_API_URL=https://api.voiceforbharat.in
NEXT_PUBLIC_WS_URL=wss://ws.voiceforbharat.in
NEXT_PUBLIC_CLOUDFRONT_URL=https://cdn.voiceforbharat.in

# AWS Cognito Configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=ap-south-1

# Application Configuration
NEXT_PUBLIC_APP_NAME=Voice for Bharat
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,hi,mr,kn,ta,te

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_VOICE_ASSISTANT=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
